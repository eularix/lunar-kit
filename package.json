{
  "name": "lunar-kit",
  "version": "0.1.20",
  "private": true,
  "description": "Universal React Native UI components",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/primitives/*",
    "packages/stubs/*",
    "docs"
  ],
  "scripts": {
    "dev": "bun --filter example start",
    "dev:showcase": "bun --filter showcase start",
    "dev:cli": "bun --filter lk dev",
    "deps:core": "bun --filter @lunar-kit/core install",
    "build:cli": "bun --filter @lunar-kit/cli build",
    "build:core": "bun --filter @lunar-kit/core build",
    "build:create": "bun --filter create-lunar-kit build",
    "build:primitives": "bun run --filter '@lunar-primitive/*' build",
    "build": "bun run build:core && bun run build:cli && bun run build:create && bun run build:primitives",
    "bump:patch": "bun scripts/bump-versions.ts patch",
    "bump:minor": "bun scripts/bump-versions.ts minor",
    "bump:major": "bun scripts/bump-versions.ts major",
    "docs:generate": "bun scripts/generate-component-docs.ts",
    "docs:sync:core": "bash scripts/sync-core-to-docs.sh",
    "docs:sync": "bash scripts/sync-core-to-docs.sh && bun scripts/sync-docs.ts",
    "registry:sync": "bun scripts/registry-sync.ts"
  },
  "keywords": [
    "react-native",
    "ui",
    "components",
    "nativewind"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.27.10"
  },
  "dependencies": {
    "fs-extra": "^11.3.4"
  },
  "overrides": {
    "expo": "54.0.34",
    "expo-modules-core": "3.0.30",
    "expo-asset": "12.0.10",
    "expo-font": "14.0.11",
    "expo-keep-awake": "15.0.8",
    "expo-linking": "8.0.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.15.4",
    "react-native-reanimated": "4.1.7",
    "react-native-worklets": "0.5.1"
  },
  "resolutions": {
    "expo": "54.0.34",
    "expo-modules-core": "3.0.30",
    "expo-asset": "12.0.10",
    "expo-font": "14.0.11",
    "expo-keep-awake": "15.0.8",
    "expo-linking": "8.0.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.15.4",
    "react-native-reanimated": "4.1.7",
    "react-native-worklets": "0.5.1"
  }
}
